{
  "expo": {
    "name": "Gym Tracker",
    "slug": "gym-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymtracker",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.abdullahthweib2004.gymtracker",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Gym Tracker uses the camera so you can photograph the machines and equipment at your gym and see them next to your exercises.",
        "NSPhotoLibraryUsageDescription": "Gym Tracker uses your photo library so you can choose a picture of a machine or exercise. Photos stay on your device.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abdullahthweib2004.gymtracker",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF6B00"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Gym Tracker uses the camera so you can photograph the machines and equipment at your gym and see them next to your exercises.",
          "photosPermission": "Gym Tracker uses your photo library so you can choose a picture of a machine or exercise. Photos stay on your device.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A0A0A",
    "extra": {
      "supportsRTL": true
    }
  }
}
